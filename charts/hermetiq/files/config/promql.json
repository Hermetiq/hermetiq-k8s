{
  "schedulerQueueDepthSum": "sum(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_queued:sum{${labels}})",
  "schedulerExecutingSum": "sum(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_executing:sum{${labels}})",
  "schedulerQueueDurationQuantile": "histogram_quantile(${quantile}, sum by (le) (avg_over_time(instance_name_prefix_le_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_queued_duration_seconds_bucket:irate1m{${labels}}[${range}])))",
  "schedulerRetriesQuantile": "histogram_quantile(${quantile}, sum by (le) (avg_over_time(instance_name_prefix_le_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_executing_retries_bucket:irate1m{${labels}}[${range}])))",
  "schedulerQueuedRate": "sum(max_over_time(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_queued:irate1m{${labels}}[${range}]))",
  "schedulerExecutingRate": "sum(max_over_time(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_executing:irate1m{${labels}}[${range}]))",
  "schedulerCompletedByCode": "sum by (grpc_code, result) (max_over_time(grpc_code_instance_name_prefix_platform_result_size_class:buildbarn_builder_in_memory_build_queue_tasks_completed:irate1m{${labels}}[${range}]))",
  "schedulerPlatformBreakdown": "instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_queued:sum{${labels}}",
  "schedulerPlatformBacklogExcess": "sum by (instance_name_prefix, platform, size_class) (min_over_time(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_queued:sum{${labels}}[10m])) - sum by (instance_name_prefix, platform, size_class) (increase(buildbarn_builder_in_memory_build_queue_tasks_queued_duration_seconds_count{${labels}}[10m]))",
  "schedulerPlatformStalledExcess": "(sum by (instance_name_prefix, platform, size_class) (min_over_time(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_queued:sum{${labels}}[10m])) - sum by (instance_name_prefix, platform, size_class) (increase(buildbarn_builder_in_memory_build_queue_tasks_queued_duration_seconds_count{${labels}}[10m]))) and on (instance_name_prefix, platform, size_class) (sum by (instance_name_prefix, platform, size_class) (max_over_time(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_executing:sum{${labels}}[10m])) == 0)",
  "schedulerPlatformExecutingPeak": "sum by (platform, size_class) (instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_executing:sum{${labels}})",
  "schedulerExecutingAverage": "avg_over_time((sum(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_executing:sum{${labels}}) or vector(0))[${range}:1m]) and on () count(last_over_time(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_executing:sum{${labels}}[${range}]))",
  "schedulerIdleShare": "avg_over_time((((sum(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_queued:sum{${labels}}) or vector(0)) + (sum(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_executing:sum{${labels}}) or vector(0))) == bool 0)[${range}:1m]) and on () count(last_over_time(instance_name_prefix_platform_size_class:buildbarn_builder_in_memory_build_queue_tasks_queued:sum{${labels}}[${range}]))",
  "workerOperationRate": "sum(kubernetes_service:buildbarn_builder_build_executor_operations:irate1m{${labels}})",
  "workerExecutionStageQuantile": "histogram_quantile(${quantile}, sum by (le) (avg_over_time(kubernetes_service_le_stage:buildbarn_builder_build_executor_duration_seconds_bucket:irate1m{${labels}}[${range}])))",
  "workerVirtualExecutionQuantile": "histogram_quantile(${quantile}, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_virtual_execution_duration_bucket:irate1m{${labels}}[${range}])))",
  "workerRssP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_posix_maximum_resident_set_size_bucket:irate1m{${labels}}[${range}])))",
  "workerCpuUserP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_posix_user_time_bucket:irate1m{${labels}}[${range}])))",
  "workerCpuSystemP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_posix_system_time_bucket:irate1m{${labels}}[${range}])))",
  "workerBlockIoInP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_posix_block_input_operations_bucket:irate1m{${labels}}[${range}])))",
  "workerBlockIoOutP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_posix_block_output_operations_bucket:irate1m{${labels}}[${range}])))",
  "workerVoluntaryCtxSwitchesP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_posix_voluntary_context_switches_bucket:irate1m{${labels}}[${range}])))",
  "workerInvoluntaryCtxSwitchesP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_posix_involuntary_context_switches_bucket:irate1m{${labels}}[${range}])))",
  "workerFilesCreatedP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_file_pool_files_created_bucket:irate1m{${labels}}[${range}])))",
  "workerFileCountPeakP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_file_pool_files_count_peak_bucket:irate1m{${labels}}[${range}])))",
  "workerFileSizePeakP90": "histogram_quantile(0.9, sum by (le) (avg_over_time(kubernetes_service_le:buildbarn_builder_build_executor_file_pool_files_size_bytes_peak_bucket:irate1m{${labels}}[${range}])))",
  "workerServiceBreakdown": "sum by (kubernetes_service) (max_over_time(kubernetes_service:buildbarn_builder_build_executor_operations:irate1m{${labels}}[${range}]))",
  "storageOpRateTotal": "sum(max_over_time(backend_type_kubernetes_service_operation_storage_type:buildbarn_blobstore_blob_access_operations_started:irate1m{${labels}}[${range}]))",
  "storageOperationsByOp": "sum by (operation) (max_over_time(backend_type_kubernetes_service_operation_storage_type:buildbarn_blobstore_blob_access_operations_started:irate1m{${labels}}[${range}]))",
  "storageLatencyQuantile": "histogram_quantile(${quantile}, sum by (le) (avg_over_time(backend_type_kubernetes_service_le_operation_storage_type:buildbarn_blobstore_blob_access_operations_duration_seconds_bucket:irate1m{${labels}}[${range}])))",
  "storageErrorCount": "sum(avg_over_time(backend_type_grpc_code_kubernetes_service_storage_type:buildbarn_blobstore_blob_access_operations_duration_seconds_count:irate1m{${labels}}[${range}]))",
  "storageOperationsByCode": "sum by (grpc_code) (increase(buildbarn_blobstore_blob_access_operations_duration_seconds_count{${labels}}[${range}]))",
  "storageEvictionAgeMin": "min(kubernetes_shard_storage_type:buildbarn_blobstore_old_current_new_location_blob_map_last_removed_old_block_insertion_time_seconds:min{${labels}})",
  "storageDiskEvictionByShard": "kubernetes_shard_storage_type:buildbarn_blobstore_old_current_new_location_blob_map_last_removed_old_block_insertion_time_seconds:min{${labels}}",
  "storageHashGetTooManyAttempts": "sum(max_over_time(storage_type:buildbarn_blobstore_hashing_key_location_map_get_too_many_attempts:irate1m{${labels}}[${range}]))",
  "storageHashPutTooManyIterations": "sum(max_over_time(storage_type:buildbarn_blobstore_hashing_key_location_map_put_too_many_iterations:irate1m{${labels}}[${range}]))",
  "storageEvictionSetOps": "kubernetes_service_name_operation:buildbarn_eviction_set_operations:rate1h{${labels}}",
  "grpcServerHandledTotal": "sum(avg_over_time(grpc_code_grpc_method_grpc_service_kubernetes_service:grpc_server_handled:irate1m{${labels}}[${range}]))",
  "grpcServerInFlightTotal": "sum(grpc_method_grpc_service_kubernetes_service:grpc_server_in_flight:sum{${labels}})",
  "grpcTopErrors": "topk(10, max_over_time(grpc_code_grpc_method_grpc_service_kubernetes_service:grpc_server_handled:irate1m{${labels}}[${range}]))",
  "grpcHandledBySide": "sum by (grpc_service, kubernetes_service, grpc_code) (max_over_time(grpc_code_grpc_method_grpc_service_kubernetes_service:grpc_${side}_handled:irate1m{${labels}}[${range}]))",
  "grpcInFlightBySide": "sum by (grpc_service, kubernetes_service) (grpc_method_grpc_service_kubernetes_service:grpc_${side}_in_flight:sum{${labels}})",
  "grpcLatencyBySideQuantile": "histogram_quantile(${quantile}, sum by (le) (avg_over_time(grpc_method_grpc_service_kubernetes_service_le:grpc_${side}_handling_seconds_bucket:irate1m{${labels}}[${range}])))",
  "storageDeviceIoUtilization": "max(rate(node_disk_io_time_seconds_total{instance=~\"${node}\", device=~\"[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+\"}[${range}]))",
  "storageDeviceWriteLatency": "max(rate(node_disk_write_time_seconds_total{instance=~\"${node}\"}[${range}]) / clamp_min(rate(node_disk_writes_completed_total{instance=~\"${node}\"}[${range}]), 1))",
  "storageDeviceWriteThroughput": "max(rate(node_disk_written_bytes_total{instance=~\"${node}\", device=~\"[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+\"}[${range}]))",
  "storageDeviceQueueDepth": "max(node_disk_io_now{instance=~\"${node}\"})",
  "storageBlobSizeBuckets": "sum by (le) (avg_over_time(backend_type_kubernetes_service_le_operation_storage_type:buildbarn_blobstore_blob_access_operations_blob_size_bytes_bucket:irate1m{${labels}}[${range}]))",
  "costNodePrices": "{__name__=~\"node_(cpu|ram|gpu|total)_hourly_cost\",${selector}}",
  "costNodeLabels": "kube_node_labels{${selector}}",
  "costNodeLabelsByClass": "kube_node_labels{${matchers}}",
  "costNodeInfo": "kube_node_info{${selector}}",
  "costNodeAllocatableCpu": "kube_node_status_allocatable{${selector},resource=\"cpu\",unit=\"core\"}",
  "costNodeAllocatableMemory": "kube_node_status_allocatable{${selector},resource=\"memory\",unit=\"byte\"}",
  "costNodeUnschedulable": "kube_node_spec_unschedulable{${selector}}",
  "costNodeConditions": "kube_node_status_condition{${selector}}",
  "rbeDeploymentReplicas": "max by (deployment) (kube_deployment_status_replicas{namespace=\"${namespace}\",deployment=~\"${deployments}\"})",
  "rbeKedaScalerMetricValue": "avg by (namespace, scaledObject, scaler, metric) (keda_scaler_metrics_value{namespace=\"${namespace}\",scaledObject=\"${scaledObject}\",type=\"scaledobject\"})",
  "rbeContainerMemoryPeak": "max by (pod, container) (max_over_time(container_memory_working_set_bytes{namespace=\"${namespace}\",pod=~\"${pods}\",container!=\"\",image!=\"\"}[${window}]))",
  "rbeContainerCpuPeak": "max by (pod, container) (max_over_time(rate(container_cpu_usage_seconds_total{namespace=\"${namespace}\",pod=~\"${pods}\",container!=\"\",image!=\"\"}[5m])[${window}:5m]))",
  "rbeContainerCpuRequestPercent": "100 * sum by (container, cluster) (rate(container_cpu_usage_seconds_total{namespace=\"${namespace}\",pod=~\"${pods}\",container!=\"\",image!=\"\"}[${rate}])) / (sum by (container, cluster) (max by (namespace, pod, container, cluster) (kube_pod_container_resource_requests{namespace=\"${namespace}\",pod=~\"${pods}\",resource=\"cpu\",job=~\"kube-state-metrics\"}) and on (namespace, pod, cluster) max by (namespace, pod, cluster) (kube_pod_status_phase{namespace=\"${namespace}\",pod=~\"${pods}\",phase=\"Running\",job=~\"kube-state-metrics\"} == 1)) > 0)",
  "rbeContainerMemoryRequestPercent": "100 * sum by (container, cluster) (container_memory_working_set_bytes{namespace=\"${namespace}\",pod=~\"${pods}\",container!=\"\",image!=\"\"}) / (sum by (container, cluster) (max by (namespace, pod, container, cluster) (kube_pod_container_resource_requests{namespace=\"${namespace}\",pod=~\"${pods}\",resource=\"memory\",job=~\"kube-state-metrics\"}) and on (namespace, pod, cluster) max by (namespace, pod, cluster) (kube_pod_status_phase{namespace=\"${namespace}\",pod=~\"${pods}\",phase=\"Running\",job=~\"kube-state-metrics\"} == 1)) > 0)",
  "rbeSchedulerExecutions": "sum by (instance_name_prefix, platform, size_class, result, grpc_code) ((increase(buildbarn_builder_in_memory_build_queue_tasks_executing_duration_seconds_count{namespace=\"${namespace}\"}[${window}]) and (count_over_time(buildbarn_builder_in_memory_build_queue_tasks_executing_duration_seconds_count{namespace=\"${namespace}\"}[${window}]) >= 2)))",
  "rbeSchedulerExecutingSeconds": "sum by (instance_name_prefix, platform, size_class, result, grpc_code) ((increase(buildbarn_builder_in_memory_build_queue_tasks_executing_duration_seconds_sum{namespace=\"${namespace}\"}[${window}]) and (count_over_time(buildbarn_builder_in_memory_build_queue_tasks_executing_duration_seconds_sum{namespace=\"${namespace}\"}[${window}]) >= 2)))",
  "rbeSchedulerQueueWaitP95": "histogram_quantile(0.95, sum by (le) ((increase(buildbarn_builder_in_memory_build_queue_tasks_queued_duration_seconds_bucket{namespace=\"${namespace}\"}[${window}]) and (count_over_time(buildbarn_builder_in_memory_build_queue_tasks_queued_duration_seconds_bucket{namespace=\"${namespace}\"}[${window}]) >= 2))))",
  "rbeIsccLookups": "sum by (grpc_code) ((increase(grpc_server_handled_total{namespace=\"${namespace}\",grpc_service=\"buildbarn.iscc.InitialSizeClassCache\",grpc_method=\"GetPreviousExecutionStats\"}[${window}]) and (count_over_time(grpc_server_handled_total{namespace=\"${namespace}\",grpc_service=\"buildbarn.iscc.InitialSizeClassCache\",grpc_method=\"GetPreviousExecutionStats\"}[${window}]) >= 2)))",
  "rbeStartupPools": "max by (deployment, owner_name) (last_over_time(kube_deployment_owner{job=\"kube-state-metrics\",namespace=\"${namespace}\",owner_kind=\"RbeWorker\"}[${window}]))",
  "rbeStartupPodDeployments": "max by (pod, deployment) (label_replace(max by (pod, owner_name) (last_over_time(kube_pod_owner{job=\"kube-state-metrics\",namespace=\"${namespace}\",owner_kind=\"ReplicaSet\"}[${window}])), \"replicaset\", \"$1\", \"owner_name\", \"(.+)\") * on (replicaset) group_left (deployment) label_replace(max by (replicaset, owner_name) (last_over_time(kube_replicaset_owner{job=\"kube-state-metrics\",namespace=\"${namespace}\",owner_kind=\"Deployment\"}[${window}])), \"deployment\", \"$1\", \"owner_name\", \"(.+)\"))",
  "rbeStartupPodCreated": "max by (pod) (last_over_time(kube_pod_created{job=\"kube-state-metrics\",namespace=\"${namespace}\"}[${window}]))",
  "rbeStartupPodScheduled": "min by (pod) (min_over_time(kube_pod_status_scheduled_time{job=\"kube-state-metrics\",namespace=\"${namespace}\"}[${window}]))",
  "rbeStartupPodReady": "min by (pod) (min_over_time(kube_pod_status_ready_time{job=\"kube-state-metrics\",namespace=\"${namespace}\"}[${window}]))",
  "rbeStartupPodNodes": "min by (pod, node) (min_over_time((max by (pod, node) (kube_pod_info{job=\"kube-state-metrics\",namespace=\"${namespace}\",node!=\"\"}) * on (node) group_left () max by (node) (kube_node_created{job=\"kube-state-metrics\"}))[${window}:${step}]))",
  "rbeStartupNodePools": "max by (node, label_cloud_google_com_gke_nodepool, label_karpenter_sh_nodepool, label_eks_amazonaws_com_nodegroup, label_kubernetes_azure_com_agentpool, label_agentpool) (last_over_time(kube_node_labels{job=\"kube-state-metrics\"}[${window}]) and on (node) last_over_time(kube_pod_info{job=\"kube-state-metrics\",namespace=\"${namespace}\",node!=\"\"}[${window}]))",
  "rbeStartupNodeStartupSeconds": "max by (node, created, part) (max_over_time((count_values by (node) (\"created\", max by (node) (kube_node_created{job=\"kube-state-metrics\"})) * on (node) group_right (created) max by (node, part) (label_replace({__name__=~\"kubelet_node_startup_(post_registration_)?duration_seconds\"}, \"part\", \"$1\", \"__name__\", \"kubelet_node_startup_(.+)_seconds\")) and on (node) kube_pod_info{job=\"kube-state-metrics\",namespace=\"${namespace}\",node!=\"\"})[${window}:${step}]))",
  "rbeStartupScaleUps": "(max by (deployment) (kube_deployment_spec_replicas{job=\"kube-state-metrics\",namespace=\"${namespace}\"}) > 0) and on (deployment) (max by (deployment) (kube_deployment_spec_replicas{job=\"kube-state-metrics\",namespace=\"${namespace}\"} offset ${resolution}) == 0)",
  "rbeStartupScaleDowns": "(max by (deployment) (kube_deployment_spec_replicas{job=\"kube-state-metrics\",namespace=\"${namespace}\"}) == 0) and on (deployment) (max by (deployment) (kube_deployment_spec_replicas{job=\"kube-state-metrics\",namespace=\"${namespace}\"} offset ${resolution}) > 0)"
}
