{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "namespaceOverride": {
      "type": "string"
    },
    "createNamespace": {
      "type": "boolean"
    },
    "watchNamespace": {
      "type": "string"
    },
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "commonAnnotations": {
      "type": "object"
    },
    "extraObjects": {
      "type": "array"
    },
    "standardLabels": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "managerBindingMode": {
          "type": "string",
          "enum": [
            "cluster",
            "namespace"
          ]
        },
        "rbeWorkerRoles": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            }
          }
        },
        "metricsReader": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "healthProbe": {
      "type": "object"
    },
    "otel": {
      "type": "object"
    },
    "enableHTTP2": {
      "type": "boolean"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "strategy": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    }
  }
}
