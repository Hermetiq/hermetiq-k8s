{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "deploymentMode": {"type": "string", "enum": ["full", "storage-only"]},
    "namespaceOverride": {"type": "string"},
    "global": {"type": "object"},
    "imagePullSecrets": {"type": "array"},
    "commonLabels": {"type": "object"},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "commonAnnotations": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "standardLabels": {"type": "object"},
    "serviceAccount": {"type": "object"},
    "configOverrides": {"type": "object"},
    "upgradeChecks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skipWorkerChecks": {"type": "boolean"},
        "skipConfigTextCheck": {"type": "boolean"},
        "skipStorageClaimTemplateCheck": {"type": "boolean"},
        "skipExternalStorageCheck": {"type": "boolean"}
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "contentAddressableStorage": {"type": "object", "properties": {"maximumChunkCount": {"type": "integer", "minimum": 1}}}
      }
    },
    "images": {"type": "object"},
    "secrets": {"type": "object"},
    "hosts": {"type": "object"},
    "tracing": {"type": "object"},
    "security": {
      "type": "object",
      "properties": {
        "pod": {
          "type": "object",
          "properties": {
            "runAsNonRoot": {"type": "boolean"},
            "runAsUser": {"type": ["integer", "null"]},
            "runAsGroup": {"type": ["integer", "null"]},
            "fsGroup": {"type": ["integer", "null"]},
            "seccompProfile": {"type": "object"}
          }
        },
        "container": {
          "type": "object",
          "properties": {
            "readOnlyRootFilesystem": {"type": "boolean"},
            "allowPrivilegeEscalation": {"type": "boolean"},
            "dropCapabilities": {"type": "array", "items": {"type": "string"}}
          }
        },
        "grpcMtls": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"},
            "mountPath": {"type": "string"},
            "certificatePath": {"type": "string"},
            "privateKeyPath": {"type": "string"},
            "refreshInterval": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?s)$"},
            "certificateAuthorities": {"type": "string"},
            "certificateAuthoritiesFile": {"type": "string"},
            "validationExpression": {"type": "string", "minLength": 1},
            "metadataExtractionExpression": {"type": "string", "minLength": 1},
            "cipherSuites": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "k8sNodeScheduling": {"type": ["object", "null"]},
    "storage": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"},
        "replicas": {"type": "integer", "minimum": 1}
      }
    },
    "vmPodScrapes": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"deploymentMode": {"const": "full"}}},
      "then": {
        "properties": {
          "createNamespace": {"type": "boolean"},
          "extraObjects": {"type": "array"},
          "bbcal": {"type": "object"},
          "routing": {
            "type": "object",
            "properties": {
              "enabled": {"type": "boolean"},
              "provider": {
                "type": "string",
                "enum": ["", "gateway", "gateway-httproute-only", "contour", "ingress", "none"]
              }
            }
          },
          "frontend": {
            "type": "object",
            "properties": {
              "podAntiAffinity": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
              "grpcCacheProxy": {
                "type": "object",
                "properties": {
                  "cacheEvents": {
                    "type": "object",
                    "properties": {"trackingMode": {"type": "string", "enum": ["on", "off", "header"]}}
                  }
                }
              }
            }
          },
          "scheduler": {
            "type": "object",
            "properties": {
              "actionRouter": {
                "type": "object",
                "properties": {
                  "mode": {"type": "string", "enum": ["simple", "demultiplexing", "custom"]},
                  "custom": {"type": "string"}
                }
              },
              "configurationReloadInterval": {
                "type": "string",
                "anyOf": [
                  {"const": ""},
                  {"pattern": "^[0-9]{1,12}(\\.[0-9]{1,9})?s$", "not": {"pattern": "^0+(\\.0+)?s$"}}
                ]
              },
              "clientGrpcServers": {
                "type": "object",
                "properties": {
                  "authenticationPolicy": {
                    "type": "object",
                    "properties": {
                      "mode": {"type": "string", "enum": ["", "allow", "deny", "mtls", "custom"]},
                      "denyMessage": {"type": "string"},
                      "custom": {"type": "string"}
                    }
                  }
                }
              },
              "workerGrpcServers": {
                "type": "object",
                "properties": {
                  "authenticationPolicy": {
                    "type": "object",
                    "properties": {
                      "mode": {"type": "string", "enum": ["", "allow", "deny", "mtls", "custom"]},
                      "denyMessage": {"type": "string"},
                      "custom": {"type": "string"}
                    }
                  }
                }
              },
              "buildQueueStateGrpcServers": {
                "type": "object",
                "properties": {
                  "authenticationPolicy": {
                    "type": "object",
                    "properties": {
                      "mode": {"type": "string", "enum": ["", "allow", "deny", "mtls", "custom"]},
                      "denyMessage": {"type": "string"},
                      "custom": {"type": "string"}
                    }
                  }
                }
              },
              "adminHttpServers": {
                "type": "object",
                "properties": {
                  "authenticationPolicy": {
                    "type": "object",
                    "properties": {
                      "mode": {"type": "string", "enum": ["", "allow", "deny", "custom"]},
                      "denyMessage": {"type": "string"},
                      "custom": {"type": "string"}
                    }
                  }
                }
              },
              "handover": {
                "type": "object",
                "properties": {
                  "enabled": {"type": "boolean"},
                  "cdcCompatibleFork": {"type": "boolean"},
                  "peerServerName": {"type": "string", "minLength": 1},
                  "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                  "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
                  "adoptionWindow": {"type": "string"},
                  "recoveredOperationGracePeriod": {"type": "string"},
                  "relayDrainPeriod": {"type": "string"},
                  "handoverGrpcServers": {
                    "type": "object",
                    "properties": {
                      "authenticationPolicy": {
                        "type": "object",
                        "properties": {
                          "mode": {"type": "string", "enum": ["", "allow", "deny", "mtls", "custom"]},
                          "denyMessage": {"type": "string"},
                          "custom": {"type": "string"}
                        }
                      }
                    }
                  },
                  "coordinator": {
                    "type": "object",
                    "properties": {
                      "leaseDurationSeconds": {"type": "integer", "minimum": 1},
                      "renewInterval": {"type": "string"},
                      "image": {"type": "object"},
                      "resources": {"type": "object"}
                    }
                  }
                }
              }
            }
          },
          "browser": {"type": "object"},
          "remoteAsset": {"type": "object"},
          "portal": {"type": "object"},
          "keda": {"type": "object"},
          "certificate": {"type": "object"},
          "tls": {"type": "object"},
          "ingress": {"type": "object"},
          "httpProxy": {"type": "object"},
          "gateway": {
            "type": "object",
            "properties": {
              "clientTrafficPolicy": {
                "type": "object",
                "properties": {
                  "enabled": {"type": "boolean"},
                  "name": {"type": "string"},
                  "sectionName": {"type": "string"},
                  "bufferLimit": {"type": ["string", "integer"]},
                  "http2": {
                    "type": "object",
                    "properties": {
                      "initialStreamWindowSize": {"type": ["string", "integer"]},
                      "initialConnectionWindowSize": {"type": ["string", "integer"]},
                      "maxConcurrentStreams": {"type": "integer", "minimum": 1, "maximum": 2147483647}
                    }
                  },
                  "timeout": {
                    "type": "object",
                    "properties": {
                      "http": {
                        "type": "object",
                        "properties": {"idleTimeout": {"type": "string", "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"}}
                      }
                    }
                  },
                  "tcpKeepalive": {
                    "type": ["object", "null"],
                    "properties": {
                      "idleTime": {"type": "string", "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"},
                      "interval": {"type": "string", "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"},
                      "probes": {"type": "integer", "minimum": 0}
                    }
                  }
                }
              }
            }
          },
          "vmRules": {"type": "object"},
          "config": {
            "type": "object",
            "properties": {
              "blobstore": {
                "type": "object",
                "properties": {
                  "deadlineEnforcing": {
                    "type": "object",
                    "properties": {
                      "timeout": {
                        "type": "string",
                        "anyOf": [
                          {"const": ""},
                          {"pattern": "^[0-9]+(\\.[0-9]+)?s$", "not": {"pattern": "^0+(\\.0+)?s$"}}
                        ]
                      }
                    }
                  }
                }
              },
              "contentAddressableStorage": {
                "type": "object",
                "properties": {
                  "cdcParameterCache": {
                    "type": "object",
                    "properties": {
                      "cacheSize": {"type": "integer", "minimum": 1},
                      "cacheDuration": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?s$",
                        "not": {"pattern": "^0+(\\.0+)?s$"}
                      },
                      "cacheReplacementPolicy": {
                        "type": "string",
                        "enum": ["FIRST_IN_FIRST_OUT", "LEAST_RECENTLY_USED", "RANDOM_REPLACEMENT"]
                      }
                    }
                  },
                  "chunkCache": {
                    "type": "object",
                    "properties": {
                      "cacheSize": {"type": "integer", "minimum": 0},
                      "cacheDuration": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?s$",
                        "not": {"pattern": "^0+(\\.0+)?s$"}
                      },
                      "cacheReplacementPolicy": {
                        "type": "string",
                        "enum": ["FIRST_IN_FIRST_OUT", "LEAST_RECENTLY_USED", "RANDOM_REPLACEMENT"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"storage": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "storage": {
            "type": "object",
            "properties": {
              "podAntiAffinity": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
              "persistence": {
                "type": "object",
                "properties": {
                  "cms": {
                    "type": "object",
                    "properties": {
                      "backend": {"type": "string", "enum": ["sharedCas", "filesystem", "blockDevice"]},
                      "blocksSizeGi": {"type": "integer", "minimum": 1},
                      "blocksInMemoryBlockSizeBytes": {"type": "integer", "minimum": 1},
                      "newBlocks": {"type": "integer", "const": 1},
                      "keyLocationMap": {
                        "type": "object",
                        "properties": {"type": {"type": "string", "enum": ["inMemory", "blockDevice"]}}
                      }
                    }
                  }
                }
              },
              "dataIntegrityValidationCache": {
                "type": "object",
                "properties": {
                  "enabled": {"type": "boolean"},
                  "cacheSize": {"type": "integer", "minimum": 0},
                  "cacheDuration": {"type": "string"},
                  "cacheReplacementPolicy": {"type": "string"}
                }
              },
              "grpcServers": {
                "type": "object",
                "properties": {
                  "authenticationPolicy": {
                    "type": "object",
                    "properties": {
                      "mode": {"type": "string", "enum": ["", "allow", "deny", "mtls", "custom"]},
                      "denyMessage": {"type": "string"},
                      "custom": {"type": "string"}
                    }
                  }
                }
              },
              "topologySpreadConstraints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"],
                  "properties": {
                    "maxSkew": {"type": "integer", "minimum": 1},
                    "topologyKey": {"type": "string", "minLength": 1},
                    "whenUnsatisfiable": {"type": "string", "enum": ["DoNotSchedule", "ScheduleAnyway"]},
                    "labelSelector": {"type": "object"}
                  }
                }
              }
            }
          },
          "config": {
            "type": "object",
            "properties": {
              "contentAddressableStorage": {
                "type": "object",
                "properties": {
                  "chunkingParameters": {
                    "type": "object",
                    "properties": {
                      "minChunkSizeBytes": {"type": "integer", "minimum": 64, "maximum": 16777216},
                      "horizonSizeBytes": {"type": "integer", "minimum": 0, "maximum": 134217728}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"deploymentMode": {"const": "storage-only"}}, "required": ["deploymentMode"]},
      "then": {"properties": {"storage": {"properties": {"enabled": {"const": true}}}}}
    }
  ]
}
