# Routing to the Testcontainers worker fleet is set per-target via
# `exec_properties = {"pool": "testcontainers"}` on go_test rules — Bazel's
# `--modify_execution_info` flag matches only on the action mnemonic, not
# on tags, so a `.*@requires-docker` regex silently never fires.


# RBE configuration is intentionally left out — supply your endpoint, mTLS
# credentials, and exec/host platforms via a `--config=rbe` block below or
# via a user-level bazelrc. Example placeholders:
#
# build:rbe --remote_executor=grpcs://bb.helm.hermetiq.dev:443
# build:rbe --remote_instance_name=
# build:rbe --remote_timeout=600
# build:rbe --jobs=64
# build:rbe --extra_execution_platforms=@rules_go//go/toolchain:linux_amd64
# build:rbe --host_platform=@rules_go//go/toolchain:linux_amd64
# build:rbe --tls_client_certificate=...
# build:rbe --tls_client_key=...
#
# Then: `bazel test --config=rbe //...`

# Hermetiq · hermetiq-demo
build:hermetiq --bes_instance_name=223056c5-94bf-4ffc-baae-34eae027b99c
build:hermetiq --bes_backend=grpcs://bep-dev.cloud-grpc.hermetiq.dev
build:hermetiq --bes_results_url=https://web-dev.hermetiq.dev/build/
build:hermetiq --bes_upload_mode=wait_for_upload_complete
build:hermetiq --show_progress_rate_limit=5
build:hermetiq --credential_helper="bep-dev.cloud-grpc.hermetiq.dev=%workspace%/tools/hermetiq-credential-helper"
build:hermetiq --credential_helper="lb.bbdev.cloud-grpc.hermetiq.dev=%workspace%/tools/hermetiq-credential-helper"

# Build metadata · branch, commit and repo, so the filters work
build:hermetiq --workspace_status_command=$(pwd)/tools/set-build-metadata.sh

# Enhanced metrics · build profiles for timing and bottleneck analysis
build:hermetiq --generate_json_trace_profile
build:hermetiq --experimental_profile_include_primary_output
build:hermetiq --experimental_profile_include_target_label
build:hermetiq --noslim_profile

# Remote cache · OPTIONAL · remove these two lines if you already run a cache
build:hermetiq --remote_instance_name=223056c5-94bf-4ffc-baae-34eae027b99c
build:hermetiq --remote_cache=grpcs://lb.bbdev.cloud-grpc.hermetiq.dev
