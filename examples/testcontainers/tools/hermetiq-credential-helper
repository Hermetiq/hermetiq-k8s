#!/usr/bin/env python3
# Hermetiq credential helper for Bazel on macOS and Linux.
#
# Safe to commit: it contains no secrets. Bazel runs it as
# "tools/hermetiq-credential-helper get" and reads the JSON it prints. It reads
# your own Hermetiq client ID and secret for this project from, in order:
#   1. HERMETIQ_M2M_CLIENT_ID and HERMETIQ_M2M_CLIENT_SECRET (CI, SSH, containers)
#   2. the macOS Keychain item "hermetiq/<project>"
#   3. the pass entry "hermetiq/<project>"
# The stored value is one line of JSON:
#   {"client_id": "...", "client_secret": "..."}
# Issue your credentials in the Hermetiq Quickstart, then run
# "tools/hermetiq-credential-helper store" once per machine and paste them.
#
# Bazel's "get" never prompts: Bazel gives it no terminal and stops it after 10
# seconds. Its output doesn't depend on the requested URL, so any
# --credential_helper scope works.
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

PROJECT_ID = "223056c5-94bf-4ffc-baae-34eae027b99c"
TOKEN_URL = "https://login-test.cloud.hermetiq.dev/v1/oauth2/token"
ITEM = "hermetiq/" + PROJECT_ID
HEADER = "x-hermetiq-m2m-access-token"
TIMEOUT_SECONDS = 8


def fail(message):
    sys.stderr.write("hermetiq-credential-helper: %s\n" % message)
    sys.exit(1)


def run(args, data=None, timeout=TIMEOUT_SECONDS):
    """Runs a secret-store command without a terminal: (code, stdout, stderr)."""
    feed = {"input": data} if data is not None else {"stdin": subprocess.DEVNULL}
    try:
        proc = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout,
                              start_new_session=True, **feed)
    except subprocess.TimeoutExpired:
        return 1, b"", ("%s timed out\n" % args[0]).encode()
    except OSError as err:
        return 1, b"", ("%s: %s\n" % (args[0], err)).encode()
    return proc.returncode, proc.stdout, proc.stderr


def parse(raw, source):
    text = raw.decode("utf-8", "replace").strip()
    # pass keeps the secret on the first line; later lines may be notes.
    for candidate in (text, text.splitlines()[0] if text else ""):
        try:
            value = json.loads(candidate)
            client_id, client_secret = value["client_id"], value["client_secret"]
        except (ValueError, KeyError, TypeError):
            continue
        if isinstance(client_id, str) and isinstance(client_secret, str) and client_id and client_secret:
            return client_id, client_secret
    fail("the %s entry %s isn't JSON with client_id and client_secret" % (source, ITEM))


def from_store(source, args, hint):
    code, out, err = run(args)
    if code != 0:
        sys.stderr.write(err.decode("utf-8", "replace"))
        fail(hint)
    return parse(out, source)


def read_credentials():
    client_id = os.environ.get("HERMETIQ_M2M_CLIENT_ID", "").strip()
    client_secret = os.environ.get("HERMETIQ_M2M_CLIENT_SECRET", "").strip()
    if client_id and client_secret:
        return client_id, client_secret
    if client_id or client_secret:
        missing = "HERMETIQ_M2M_CLIENT_SECRET" if client_id else "HERMETIQ_M2M_CLIENT_ID"
        fail("%s is not set; set both HERMETIQ_M2M_CLIENT_ID and HERMETIQ_M2M_CLIENT_SECRET" % missing)
    # A store that has the item but can't open it fails with its own error
    # instead of falling through; Bazel shows stderr only when a helper fails.
    if shutil.which("security") and run(["security", "find-generic-password", "-s", ITEM])[0] == 0:
        return from_store("Keychain", ["security", "find-generic-password", "-s", ITEM, "-w"],
                          "can't read %s from the Keychain; over SSH, run 'security unlock-keychain' first" % ITEM)
    store = os.environ.get("PASSWORD_STORE_DIR") or os.path.join(os.path.expanduser("~"), ".password-store")
    if os.path.isfile(os.path.join(store, ITEM + ".gpg")):
        return from_store("pass", ["pass", "show", ITEM],
                          "pass can't decrypt %s; run 'pass show %s' in a terminal to unlock your GPG key" % (ITEM, ITEM))
    fail("no %s credentials in env, Keychain or pass; issue them in the Hermetiq Quickstart" % ITEM)


def fetch_token(client_id, client_secret):
    body = json.dumps({"client_id": client_id, "client_secret": client_secret,
                       "grant_type": "client_credentials"}).encode("utf-8")
    request = urllib.request.Request(TOKEN_URL, data=body, method="POST", headers={
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": "hermetiq-credential-helper",
    })
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
            payload = response.read()
    except urllib.error.HTTPError as err:
        payload = err.read()
    except (urllib.error.URLError, OSError) as err:
        fail("can't reach %s: %s" % (TOKEN_URL, getattr(err, "reason", err)))
    try:
        token = json.loads(payload.decode("utf-8")).get("access_token")
    except (ValueError, AttributeError):
        token = None
    if not isinstance(token, str) or not token:
        fail("Hermetiq token request failed: %s" % payload.decode("utf-8", "replace")[:500])
    return token


def store():
    """Saves pasted credentials to the macOS Keychain, or to pass elsewhere."""
    import getpass
    # getpass(3), behind the Keychain's own password prompt, keeps only 128
    # characters; Python reads the whole line. When stdin is piped, read stdin
    # directly instead of opening /dev/tty.
    try:
        if sys.stdin.isatty():
            value = getpass.getpass("Paste your Hermetiq credentials (input is hidden): ").strip()
        else:
            value = sys.stdin.readline().strip()
    except (EOFError, KeyboardInterrupt):
        fail("nothing stored")
    try:
        creds = json.loads(value)
        valid = isinstance(creds, dict) and all(
            isinstance(creds.get(key), str) and creds.get(key) for key in ("client_id", "client_secret"))
    except ValueError:
        valid = False
    if not valid:
        fail("that isn't the one line of JSON from Copy credentials in the Hermetiq Quickstart; nothing stored")
    if shutil.which("security"):
        # security takes the value only as an argument, so it is briefly
        # visible to local process listings.
        where = "the macOS Keychain"
        try:
            account = getpass.getuser()
        except Exception:
            account = "hermetiq"
        code, _, err = run(["security", "add-generic-password", "-U", "-a", account, "-s", ITEM, "-w", value],
                           timeout=60)
    elif shutil.which("pass"):
        where = "pass"
        code, _, err = run(["pass", "insert", "--multiline", "--force", ITEM], data=(value + "\n").encode("utf-8"),
                           timeout=60)
    else:
        fail("found neither the macOS Keychain nor pass; set HERMETIQ_M2M_CLIENT_ID and HERMETIQ_M2M_CLIENT_SECRET instead")
    if code != 0:
        sys.stderr.write(err.decode("utf-8", "replace"))
        fail("couldn't store %s in %s" % (ITEM, where))
    sys.stderr.write("Stored %s in %s.\n" % (ITEM, where))


def main():
    args = sys.argv[1:]
    if args == ["store"]:
        store()
        return
    if args not in ([], ["get"]):
        fail("usage: tools/hermetiq-credential-helper [get|store]")
    # Bazel sends "get" and a JSON request on stdin; neither changes the answer.
    token = fetch_token(*read_credentials())
    sys.stdout.write(json.dumps({"headers": {HEADER: [token]}}, separators=(",", ":")) + "\n")


if __name__ == "__main__":
    main()
