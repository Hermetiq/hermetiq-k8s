module(
    name = "testcontainers_redis_example",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.51.0")

# Hermetic LLVM toolchain. Avoids the Bazel-auto-detected-GCC issue where
# protoc/upb/abseil host-tool builds include builtin GCC headers via absolute
# paths that aren't registered as the toolchain's builtin include directories.
# Downloads a ~1 GB clang/libc once and caches it.
bazel_dep(name = "toolchains_llvm", version = "1.7.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "17.0.6")
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_redis_go_redis_v9",
    "com_github_testcontainers_testcontainers_go",
    "com_github_testcontainers_testcontainers_go_modules_redis",
)
